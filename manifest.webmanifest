{
  "name": "ClipSync",
  "short_name": "ClipSync",
  "description": "Private real-time clipboard sharing between your devices.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e0f13",
